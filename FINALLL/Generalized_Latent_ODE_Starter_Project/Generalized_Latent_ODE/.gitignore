!data/geolife/raw/SOURCE.md
# per-file / per-segment / per-target tables and coordinate-level outputs
results/geolife/dataset_statistics.csv
results/geolife/audit_histograms.npz
results/geolife/pilot/*/*.csv
results/geolife/pilot/pilot_summary.csv
results/geolife/main_evaluation/*.csv
results/geolife/main_evaluation/*.npz
# figures that draw individual users' GPS paths (regenerate locally with the scripts)
results/geolife/figures/fig1_geolife_examples.png
results/geolife/figures/fig2_gps_with_observations.png
results/geolife/figures/fig3_method_comparison.png
results/geolife/figures/fig4_best_median_worst.png
results/geolife/pilot/*/*.png

